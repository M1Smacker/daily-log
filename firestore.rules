rules_version = '2';

// Security rules for Daily log. The app's code is public, so these rules are the only
// thing that keeps the data private.
//
// Everything is denied unless a rule below allows it. The only thing allowed is one
// signed-in user reading and writing documents under their own id.
//
// BEFORE PUBLISHING: replace OWNER_UID_GOES_HERE with your user id. The app shows it in
// Settings, under Account, once you have signed in for the first time.

service cloud.firestore {
  match /databases/{database}/documents {

    // Pinned to one account. A stranger who signs in with Google gets their own id, which is not this one.
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == 'OWNER_UID_GOES_HERE';
    }

    function isDayKey(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A number field that may be missing, and must be sane if present.
    function optionalNumber(data, field, max) {
      return !(field in data) || data[field] == null
        || (data[field] is number && data[field] >= 0 && data[field] <= max);
    }

    match /users/{uid} {

      // Profile and plan changes: two known documents, both small maps.
      match /meta/{doc} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && doc in ['profile', 'plan']
          && request.resource.data.size() <= 20;
      }

      // One document per day.
      match /days/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isDayKey(day)
          && request.resource.data.keys().hasOnly([
               'food', 'steps', 'waterMl', 'weightKg', 'waistCm', 'creatine', 'vitaminD',
               'session', 'workout', 'cardio', 'photos'])
          && optionalNumber(request.resource.data, 'steps', 200000)
          && optionalNumber(request.resource.data, 'waterMl', 20000)
          && optionalNumber(request.resource.data, 'weightKg', 400)
          && optionalNumber(request.resource.data, 'waistCm', 300)
          && (!('food' in request.resource.data)
              || (request.resource.data.food is list && request.resource.data.food.size() <= 100))
          && (!('cardio' in request.resource.data)
              || (request.resource.data.cardio is list && request.resource.data.cardio.size() <= 20));
      }

      // Whole-app copies: one a day, plus the one taken just before a restore.
      match /backups/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (isDayKey(id) || id == 'before-restore')
          && request.resource.data.keys().hasOnly(['id', 'at', 'days', 'bytes', 'json'])
          && request.resource.data.json is string
          && request.resource.data.json.size() <= 1000000;
      }

      // Your own foods, and edits to the preloaded ones.
      match /foods/{food} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && food.size() <= 60
          && request.resource.data.size() <= 15
          && request.resource.data.id == food
          && (('hidden' in request.resource.data)
              || (request.resource.data.name is string && request.resource.data.name.size() <= 80
                  && request.resource.data.kcal is number && request.resource.data.kcal <= 10000));
      }
    }
  }
}
